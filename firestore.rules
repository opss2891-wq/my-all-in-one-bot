rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the document belongs to the authenticated user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read, write: if isOwner(resource.data.userId) || (request.method == 'create' && isOwner(request.resource.data.userId));
      
      // Messages sub-collection logic (if we were using sub-collections, but they are root level here)
    }

    // Messages collection
    match /messages/{messageId} {
      allow read, write: if isOwner(resource.data.userId) || (request.method == 'create' && isOwner(request.resource.data.userId));
    }

    // Tasks collection (Legacy/Individual)
    match /tasks/{taskId} {
      allow read, write: if isOwner(resource.data.userId) || (request.method == 'create' && isOwner(request.resource.data.userId));
    }

    // Credentials collection (Legacy/Individual)
    match /credentials/{credentialId} {
      allow read, write: if isOwner(resource.data.userId) || (request.method == 'create' && isOwner(request.resource.data.userId));
    }
  }
}